# Copy to .env.travel (git-ignored), then chmod 600 .env.travel.
# Never paste a real key into this example, browser code, or chat.
KAYAK_MODE=off
KAYAK_API_KEY=
# Production only: exact partner origin supplied by KAYAK. No URL path/query.
KAYAK_BASE_URL=
TRAVEL_PORT=4174

# Keep false while the OpenWeather account is blocked. No local config.json key is read.
OPENWEATHER_ENABLED=false
OPENWEATHER_API_KEY=
